# Optional song recognition provider. Only a short audio clip is sent when the user enables it.
AUDD_API_TOKEN=

# Preferred official lyrics provider.
# Get an API key / plan from Musixmatch and keep the key private.
MUSIXMATCH_API_KEY=

# Optional generic licensed full-lyrics provider adapter.
LICENSED_LYRICS_API_URL=
LICENSED_LYRICS_API_TOKEN=

# Try multiple short clips if the first recognition misses an intro.
AUDD_MAX_ATTEMPTS=2
